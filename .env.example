# ─────────────────────────────────────────────────────────────────────────────
# Data mode
# "mock" — run on local mock data, no backend required.
# ""     — live mode, proxies through Next.js to API_INTERNAL_URL.
# ─────────────────────────────────────────────────────────────────────────────
# Mock demo logins (any password) when NEXT_PUBLIC_DATA_MODE=mock:
#   alice@acme.com    — full app (has org)
#   onboard@demo.com  — onboarding flow (no org)
NEXT_PUBLIC_DATA_MODE=mock

# Wave 5 — AI Agent Playground (set false to show unavailable state in admin)
# NEXT_PUBLIC_AIAGENT_PLAYGROUND_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Backend connection
#
# API_INTERNAL_URL   — BE origin used by Next rewrite (server-only).
#                      Browser calls relative /api/* (see shared/lib/api-paths.ts).
#                      Never expose to the browser (no NEXT_PUBLIC_ prefix).
#
# NEXT_PUBLIC_API_URL — Leave EMPTY in local dev so the browser uses relative
#                       /api/* via the Next proxy above.
#                       Set only when calling the BE origin directly.
# ─────────────────────────────────────────────────────────────────────────────
API_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=
